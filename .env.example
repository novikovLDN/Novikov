# ─── Gmail SMTP (для отправки кодов) ─────────────────────────────
# 1. Включите двухфакторную аутентификацию в Google аккаунте
# 2. Создайте App Password: https://myaccount.google.com/apppasswords
# 3. Вставьте email и сгенерированный 16-символьный пароль
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ─── Application ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Atlas Secure
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Xray Server Integration ────────────────────────────────────
XRAY_API_HOST=127.0.0.1:10085
XRAY_SERVER_DOMAIN=vpn.atlas-secure.com
XRAY_SERVER_PORT=443
XRAY_PROTOCOL=vless
XRAY_FLOW=xtls-rprx-vision
XRAY_NETWORK=tcp
XRAY_SECURITY=reality
XRAY_SNI=www.google.com
XRAY_FINGERPRINT=chrome
XRAY_PUBLIC_KEY=your-reality-public-key
XRAY_SHORT_ID=your-short-id

# ─── Panel API (optional, for 3x-ui / Marzban) ──────────────────
XRAY_PANEL_URL=https://panel.example.com/api
XRAY_PANEL_TOKEN=your-panel-token

# ─── Session ─────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-random-string
