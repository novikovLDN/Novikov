# ─── Яндекс SMTP (для отправки кодов) ────────────────────────────
# 1. Зайдите в Яндекс Почту → Настройки → Безопасность
# 2. Включите «Пароли приложений» и создайте новый
# 3. Вставьте email и сгенерированный пароль приложения
SMTP_USER=your-email@yandex.ru
SMTP_PASS=your-app-password

# ─── Application ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Atlas Secure
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Xray Server Integration ────────────────────────────────────
XRAY_API_HOST=127.0.0.1:10085
XRAY_SERVER_DOMAIN=vpn.atlas-secure.com
XRAY_SERVER_PORT=443
XRAY_PROTOCOL=vless
XRAY_FLOW=xtls-rprx-vision
XRAY_NETWORK=tcp
XRAY_SECURITY=reality
XRAY_SNI=www.google.com
XRAY_FINGERPRINT=chrome
XRAY_PUBLIC_KEY=your-reality-public-key
XRAY_SHORT_ID=your-short-id

# ─── Xray FastAPI (управление пользователями) ───────────────────
XRAY_API_URL=https://api.mynewllcw.com
XRAY_API_KEY=your-api-key

# ─── Session ─────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-random-string
